{
  "name": "@markup-carve/carve-okf",
  "version": "0.1.0",
  "description": "Export Carve documents to an Open Knowledge Format (OKF) bundle",
  "type": "module",
  "bin": { "carve-okf": "dist/cli.js" },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "keywords": ["carve", "okf", "open-knowledge-format", "markdown", "export", "converter"],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": { "node": ">=20" },
  "repository": { "type": "git", "url": "git+https://github.com/markup-carve/carve-okf.git" },
  "bugs": { "url": "https://github.com/markup-carve/carve-okf/issues" },
  "homepage": "https://github.com/markup-carve/carve-okf#readme",
  "author": "Mark Scherer",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "dependencies": {
    "@markup-carve/carve": "^0.1.6",
    "js-yaml": "^4.1.0",
    "smol-toml": "^1.3.4"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
